{
  "name": "@meridian/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.config.extension.ts"
  },
  "trinity": {
    "role": "package",
    "targets": [
      {
        "type": "Web App",
        "label": "GitHub Pages"
      },
      {
        "type": "Extension",
        "label": "Browser extension",
        "review": true
      }
    ],
    "embeds": [
      "packages/core"
    ]
  },
  "dependencies": {
    "@meridian/core": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
