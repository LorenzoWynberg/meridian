{
  "name": "@meridian/sdk",
  "version": "0.1.2",
  "description": "Tiny unit converter library for length, mass and temperature",
  "keywords": [
    "unit converter",
    "length",
    "mass",
    "temperature"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LorenzoWynberg/meridian.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup"
  },
  "devDependencies": {
    "@meridian/core": "workspace:*",
    "tsup": "^8.5.0"
  },
  "trinity": {
    "role": "package",
    "targets": [
      {
        "type": "Library",
        "label": "npm library"
      }
    ],
    "embeds": [
      "packages/core"
    ]
  }
}
